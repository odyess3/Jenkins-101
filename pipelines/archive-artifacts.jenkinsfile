pipeline
{
    agent any

    stages { 
        stage(" script"){
            steps{
                echo "running script"

               
                 sh"""
                 def currentPath = pwd()
                 echo "Current workspace path: ${currentPath}"
                 df -hl > text.jar
                """
            }
        }
    }

    post{
        success{
            archiveArtifacts artifacts: "text.jar"
        }
    }
}