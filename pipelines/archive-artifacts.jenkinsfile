pipeline
{
    agent any

    stages { 
        stage(" script"){
            steps{
                echo "running script"
                 sh"""
                 cd ~/test
                 df -hl > text.jar
                """
            }
        }

        stage("archive"){
            steps{
                post{
                    success{
                        archiveArtifacts: "text.jar"
                    }
                }
            }
        }
        
    }
}