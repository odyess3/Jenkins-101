String branchName = env.main
String gitCredentials = "basic_credits"
String repoUrl = "https://github.com/odyess3/Jenkins-101.git"


pipeline
{
    agent any

    stages { 
        stage ("Clone a repo") {
            steps {
                script{
                    git credentialsId: "2d8fc68f-1087-431e-939b-87683e9a7da7", url: "https://github.com/odyess3/Python.git", git branch: "main"

                    sh "git checkout main"
                    
                }
            }
        }
    }
}