String branchName = env.main
String gitCredentials = "basic_credits"
String repoUrl = "https://github.com/odyess3/Jenkins-101.git"


pipeline
{
    agent any

    stages { 
        stage ("Clone a repo") {
            steps {
                echo "making the directortory"
                sh "mkdir -p build"

                echo "cloning files from branch: "+branchName
                dir("build"){
                    credentialsId: gitCredentials, url: repoUrl
                }
            }
        }
    }
}