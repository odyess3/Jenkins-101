pipeline
{
    agent any

    stages {
        
        stage ("1") {
            steps {
                sh """ #!/bin/bash
                echo "start"
                sleep 5s
                """
            }

        }

        stage("2") {
            steps{
                sh """ #!/bin/bash
                echo "5 secounds later"
                sleep 25s
                """
            }
        }
    }
    
}