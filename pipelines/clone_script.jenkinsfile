pipeline
{
    agent any

    stages { 
        stage ("Clone a repo") {
            steps {
                echo "Cloning the repo"
                git(
                    branch: "main",
                    credentialsId: "2d8fc68f-1087-431e-939b-87683e9a7da7",
                    url: "https://github.com/odyess3/Python.git"
                )
            }
        }
        
        stage("Python script"){
            steps{
                echo "running script"
                sh"""
                cd /var/lib/jenkins/jobs/Easy-Challenges/jobs/clone-script
                #cd /mnt/c/Users/260004669/Documents/GitHub/Python/Day_17
                python3 main.py
                """
            }
        }
    }
}