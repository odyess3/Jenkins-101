pipeline
{
    agent any

    stages { 
        stage ("Clone a repo") {
            steps {
                echo "Cloning the repo"
                git(
                    branch: "main",
                    credentialsId: "2d8fc68f-1087-431e-939b-87683e9a7da7",
                    url: "https://github.com/odyess3/Python.git"
                )
            }
        }
        stage("Python Installation"){
            steps{
                sh"""
                python3 --version
                """
            }
        }

        stage("Python script"){
            steps{
                sh """
                    echo "Installing Python"
                    pyhon3 -m venv venv
                    source venv/bin/activate
                    pip install -r requirements.txt
                    
                """
            }
        }
    }
}