


pipeline
{
    agent any
    
    parameters{
    string(name: 'NAME', defaultValue: 'Mr Jenkins', description: 'Who should I say hello to?')

    text(name: 'TEXT', defaultValue: '', description: 'Enter some information about the person')

    booleanParam(name: 'BOOLEAN', defaultValue: true, description: 'Toggle this value')

    choice(name: 'CHOICE', choices: ['One', 'Two', 'Three'], description: 'Pick something')

    password(name: 'PASSWORD', defaultValue: 'SECRET', description: 'Enter a password')

    }


    stages { 
        stage("Python script"){
            steps{
                echo "running script"
                sh"""
                cd /mnt/c/Users/260004669/Documents/GitHub/Jenkins-101
                python3 randomscript.py
                """
            }
        }
    }
}